{
  "$id": "urn:stockarmobile:HandoffRequest:v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffRequest.v1",
  "type": "object",
  "required": ["company_id","conversation_id","requested_by_user_id","reason","trace_id"],
  "properties": {
    "company_id": { "type": "integer" },
    "conversation_id": { "type": "integer" },
    "requested_by_user_id": { "type": "integer" },
    "reason": { "type": "string" },
    "priority": { "type": "string", "enum": ["low","medium","high"], "default": "medium" },
    "suggested_user_id": { "type": ["integer", "null"] },
    "metadata": { "type": "object" },
    "idempotency_key": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
