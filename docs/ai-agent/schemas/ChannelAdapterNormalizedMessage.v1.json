{
  "$id": "urn:stockarmobile:ChannelAdapterNormalizedMessage:v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChannelAdapterNormalizedMessage.v1",
  "type": "object",
  "required": ["company_id","external_message_id","channel","raw_payload","normalized_message","timestamp"],
  "properties": {
    "company_id": { "type": "integer" },
    "external_message_id": { "type": "string" },
    "channel": { "type": "string" },
    "raw_payload": { "type": "object" },
    "normalized_message": { "$ref": "./ConversationMessage.v1.json#" },
    "signature_valid": { "type": ["boolean", "null"] },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
