    "company_id": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "payload": { "type": "object", "required":["tool_run_id","tool_name","company_id"], "properties": { "tool_run_id": { "type": "integer" }, "tool_name": { "type": "string" }, "company_id": { "type": "integer" }, "parameters": { "type": "object" } } }
  },
  "additionalProperties": false
}
