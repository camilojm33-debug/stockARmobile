{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent.run.requested.v1",
  "type": "object",
  "required": ["event_id","event_type","version","company_id","timestamp","trace_id","payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "const": "agent.run.requested" },
    "version": { "type": "string", "const": "1" },
    "company_id": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["agent_run_id","agent_id","conversation_id","company_id"],
      "properties": {
        "agent_run_id": { "type": "integer" },
        "agent_id": { "type": "integer" },
        "conversation_id": { "type": "integer" },
        "company_id": { "type": "integer" },
        "input": { "type": "object" },
        "requested_by": { "type": "object" }
      }
    }
  },
  "additionalProperties": false
}
