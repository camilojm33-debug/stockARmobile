{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "human.handoff.requested.v1",
  "type": "object",
  "required": ["event_id","event_type","version","company_id","timestamp","trace_id","payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "const": "human.handoff.requested" },
    "version": { "type": "string", "const": "1" },
    "company_id": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "payload": { "type": "object", "required":["conversation_id","reason","requested_by_user_id"], "properties": { "conversation_id": { "type": "integer" }, "reason": { "type": "string" }, "priority": { "type": "string" }, "suggested_user_id": { "type": ["integer","null"] } } }
  },
  "additionalProperties": false
}
