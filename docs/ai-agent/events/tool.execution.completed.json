{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tool.execution.completed.v1",
  "type": "object",
  "required": ["event_id","event_type","version","company_id","timestamp","trace_id","payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "const": "tool.execution.completed" },
    "version": { "type": "string", "const": "1" },
    "company_id": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "payload": { "type": "object", "required":["tool_run_id","status"], "properties": { "tool_run_id": { "type": "integer" }, "status": { "type": "string" }, "result": { "type": ["object","null"] }, "error": { "type": ["object","null"] }, "execution_time_ms": { "type": "integer" } } }
  },
  "additionalProperties": false
}
