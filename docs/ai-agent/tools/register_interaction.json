{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "register_interaction Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "register_interaction" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Register an interaction in the audit log (append-only)." },
    "parameters_schema": { "type": "object", "required":["conversation_id","kind"], "properties": { "conversation_id": { "type": "integer" }, "kind": { "type": "string" }, "payload": { "type": "object" } } },
    "returns_schema": { "type": "object", "properties": { "interaction_id": { "type": "integer" }, "recorded_at": { "type": "string", "format": "date-time" } } },
    "permissions_required": ["interactions:create"],
    "tenant_scoped": true,
    "read_write": "write",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "full",
    "timeout_seconds": 5,
    "rate_limit": { "per_minute": 60, "per_company": 600 }
  }
}
