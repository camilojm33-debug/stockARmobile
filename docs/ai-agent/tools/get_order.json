{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get_order Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "get_order" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Get order/purchase details (read-only)." },
    "parameters_schema": { "type": "object", "required":["order_id"], "properties": { "order_id": { "type": "integer" } } },
    "returns_schema": { "type": "object", "properties": { "order_id": { "type": "integer" }, "status": { "type": "string" }, "items": { "type": "array" }, "totals": { "type": "object" } } },
    "permissions_required": ["orders:read"],
    "tenant_scoped": true,
    "read_write": "read",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "basic",
    "timeout_seconds": 10,
    "rate_limit": { "per_minute": 60, "per_company": 600 }
  }
}
