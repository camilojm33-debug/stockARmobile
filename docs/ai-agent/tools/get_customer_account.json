{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get_customer_account Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "get_customer_account" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Get account statement / balance for a customer (read-only)." },
    "parameters_schema": { "type": "object", "required":["client_id"], "properties": { "client_id": { "type": "integer" } } },
    "returns_schema": { "type": "object", "properties": { "client_id": { "type": "integer" }, "balance": { "type": "number" }, "invoices_due": { "type": "integer" }, "last_payments": { "type": "array" } } },
    "permissions_required": ["clients:read","accounts:read"],
    "tenant_scoped": true,
    "read_write": "read",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "basic",
    "timeout_seconds": 10,
    "rate_limit": { "per_minute": 30, "per_company": 300 }
  }
}
