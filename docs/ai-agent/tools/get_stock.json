{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get_stock Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "get_stock" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Get stock levels for a product (read-only)." },
    "parameters_schema": { "type": "object", "required":["product_id"], "properties": { "product_id": { "type": "integer" }, "location_id": { "type": ["integer","null"] } } },
    "returns_schema": { "type": "object", "properties": { "product_id": { "type": "integer" }, "stock": { "type": "number" }, "reserved": { "type": "number" } } },
    "permissions_required": ["products:read","stock:read"],
    "tenant_scoped": true,
    "read_write": "read",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "basic",
    "timeout_seconds": 5,
    "rate_limit": { "per_minute": 120, "per_company": 1200 }
  }
}
