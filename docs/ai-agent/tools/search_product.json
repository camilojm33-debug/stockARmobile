{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "search_product Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "search_product" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Search products by name, barcode or filters (read-only)." },
    "parameters_schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "filters": { "type": "object" }
      },
      "required": ["query"]
    },
    "returns_schema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id","name"],
            "properties": { "product_id": { "type": "integer" }, "barcode": { "type": "string" }, "name": { "type": "string" }, "price": { "type": "number" }, "stock": { "type": "number" } }
          }
        },
        "total": { "type": "integer" }
      }
    },
    "permissions_required": ["products:read"],
    "tenant_scoped": true,
    "read_write": "read",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "basic",
    "timeout_seconds": 10,
    "rate_limit": { "per_minute": 60, "per_company": 600 }
  }
}
