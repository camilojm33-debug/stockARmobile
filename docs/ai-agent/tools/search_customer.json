{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "search_customer Tool Descriptor",
  "type": "object",
  "required": ["name","version","description","parameters_schema","returns_schema","permissions_required","tenant_scoped","read_write","idempotent","audit_level","timeout_seconds"],
  "properties": {
    "name": { "const": "search_customer" },
    "version": { "type": "string", "const": "v1" },
    "description": { "type": "string", "const": "Search customers by name, phone or email (read-only)." },
    "parameters_schema": { "type": "object", "required":["query"], "properties": { "query": { "type": "string" }, "limit": { "type": "integer" } } },
    "returns_schema": { "type": "object", "properties": { "items": { "type": "array","items": { "type": "object","properties": { "client_id": { "type": "integer" }, "name": { "type": "string" }, "phone": { "type": "string" } } } } } },
    "permissions_required": ["clients:read"],
    "tenant_scoped": true,
    "read_write": "read",
    "requires_confirmation": false,
    "idempotent": true,
    "audit_level": "basic",
    "timeout_seconds": 10,
    "rate_limit": { "per_minute": 60, "per_company": 600 }
  }
}
